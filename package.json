{
  "name": "jp-wod",
  "version": "0.1.0",
  "description": "Japanese word of the day with example sentences from a local Ollama model.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "kuromoji": "^0.1.2"
  },
  "author": "Cleomene Nelli",
  "build": {
    "appId": "com.jpwod.app",
    "productName": "JP WOD",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "JP WOD",
      "createDesktopShortcut": false
    }
  },
  "engines": {
    "node": ">=22.2.0"
  }
}
